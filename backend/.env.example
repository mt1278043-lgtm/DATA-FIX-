# Copy to .env (or export these) before running the backend in production.
# None of these are required for local/dev use — sensible defaults are built in.

# SQLite by default. Point this at a Postgres URL to move off SQLite later,
# e.g. postgresql://user:password@localhost:5432/datafix
DATAFIX_DATABASE_URL=

# Change this in any real deployment — it signs auth tokens.
DATAFIX_SECRET_KEY=change-me-to-a-long-random-string

# Max upload size in MB.
DATAFIX_MAX_UPLOAD_MB=200

# Optional: set this to a real Anthropic API key to enable a genuine LLM-backed
# SQL generator later (services/nl_to_sql.py currently uses a transparent,
# rule-based heuristic instead, since no key is configured by default).
# ANTHROPIC_API_KEY=
